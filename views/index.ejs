<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head.ejs") %>
  <body>
    <form class="js-form" action="/" method="post">
      <h3>Choose winner of the day</h3>

      <ul class="players">
        <% allPlayers.forEach(player => { %>

        <li class="players" data-player-id="<%=player._id %>">
          <span class="player__name js-player-name" data-player-id="<%=player._id %>"><%=player.name%></span>:
          <span class="player__score js-player-score" data-player-id="<%=player._id %>"><%= player.score %></span>
        </li>

        <% }); %>
      </ul>
      <button type="submit">Play</button>
    </form>
  </body>
</html>
